DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental
# Used by the vitest isolation suite only. Point it at a scratch database.
TEST_DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental_test

PORT=4000
NODE_ENV=development

# Public origin of the portal. Used to build the deep links inside emails.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Vendors: email + password. Internal users (admin_user / sales_user) sign in
# with a one-time code instead, so they never get a password hash.
VENDOR_PASSWORD_MIN_LENGTH=10
ACTIVATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_RESET_PER_15MIN=5
RATE_LIMIT_OTP_REQUEST_PER_15MIN=5
RATE_LIMIT_OTP_VERIFY_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=600

# ---------------------------------------------------------------------------
# Microsoft 365 shared mailbox (SMTP relay). Brief section 3 allows Graph or
# SMTP; this build talks SMTP, matching the CustomerPulse mailer.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cranes@sanghvimovers.com
SMTP_PASS=replace-me
MAIL_FROM="SML Crane Portal <cranes@sanghvimovers.com>"
# Internal recipients for operational mail (onboarding submitted, etc.)
INTERNAL_NOTIFY_EMAIL=cranes@sanghvimovers.com

# ---------------------------------------------------------------------------
# Field encryption (AES-256-GCM). 32-byte key, base64 or hex.
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# ---------------------------------------------------------------------------
# File storage. A StorageProvider interface (lib/storage) with a local-disk
# driver now and an S3 driver to follow; swap with STORAGE_DRIVER.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------------------
# Mapping / distance. The provider decision is on hold (brief section 4),
# so only the stub is wired up. `stub` returns fixed test coordinates;
# `disabled` makes every geocode fail, which is what production should use
# until a real provider is chosen.
# ---------------------------------------------------------------------------
GEO_PROVIDER=stub
DISTANCE_CACHE_DAYS=30

# ---------------------------------------------------------------------------
# Business thresholds (overridable per row in app_settings)
# ---------------------------------------------------------------------------
FLEET_APPROVAL_REQUIRED=false
STALE_DUE_DAYS=30
STALE_FLAG_DAYS=60
STALE_REMINDER_REPEAT_DAYS=7
RFQ_REMINDER_LEAD_HOURS=24
# Scratch database used only by `prisma migrate diff` to replay migration
# history. Created and dropped automatically; never holds real data.
SHADOW_DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental_shadow

# --- M2 onboarding ---
# How long a vendor invitation link stays usable, and how long a rejected
# vendor can correct and resubmit before the link lapses.
ONBOARDING_INVITATION_TTL_DAYS=30
ONBOARDING_RESUBMIT_WINDOW_DAYS=30
