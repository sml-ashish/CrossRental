DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental
# Used by the vitest isolation suite only. Point it at a scratch database.
TEST_DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental_test

PORT=4000
NODE_ENV=development

# Public origin of the portal. Used to build the deep links inside emails.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Vendors: email + password. Internal users (admin_user / sales_user) sign in
# with a one-time code instead, so they never get a password hash.
VENDOR_PASSWORD_MIN_LENGTH=10
ACTIVATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5

# P5 SSO (Microsoft Entra ID, OIDC). Leave SSO_PROVIDER=disabled to keep OTP
# as the only internal sign-in. Enable only when every value below is set.
SSO_PROVIDER=disabled
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Must match the redirect URI registered on the Entra app. Points at the
# frontend callback, which posts the code and state back to the API.
SSO_REDIRECT_URI=http://localhost:5173/auth/sso
SSO_ALLOWED_DOMAINS=sanghvimovers.com

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_RESET_PER_15MIN=5
RATE_LIMIT_OTP_REQUEST_PER_15MIN=5
RATE_LIMIT_OTP_VERIFY_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=600

# ---------------------------------------------------------------------------
# Microsoft 365 shared mailbox (SMTP relay). Brief section 3 allows Graph or
# SMTP; this build talks SMTP, matching the CustomerPulse mailer.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cranes@sanghvimovers.com
SMTP_PASS=replace-me
MAIL_FROM="SML Crane Portal <cranes@sanghvimovers.com>"
# Internal recipients for operational mail (onboarding submitted, etc.)
INTERNAL_NOTIFY_EMAIL=cranes@sanghvimovers.com

# ---------------------------------------------------------------------------
# P6 WhatsApp (Meta Cloud API). Leave WHATSAPP_PROVIDER=disabled until the
# phone number, permanent token, webhook verify token, app secret and approved
# template all exist. The template takes five body parameters in this order:
# vendor name, RFQ number, site location, submission deadline, portal link.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# P6 inbound email replies. Poll the shared mailbox over IMAP; polling is off
# unless IMAP_POLL_ENABLED=true and the credentials are set. The mailbox is
# read-only apart from marking ingested messages Seen.
# ---------------------------------------------------------------------------
IMAP_POLL_ENABLED=false
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=cranes@sanghvimovers.com
IMAP_PASS=replace-me
IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------------------
# Field encryption (AES-256-GCM). 32-byte key, base64 or hex.
# ---------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key

# ---------------------------------------------------------------------------
# File storage. A StorageProvider interface (lib/storage) with a local-disk
# driver now and an S3 driver to follow; swap with STORAGE_DRIVER.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------------------
# Mapping / distance (Google Maps).
#
# `google`  real geocoding (Geocoding API) and road distance (Routes API).
# `stub`    fixed synthetic coordinates and distances. Development and tests.
# `disabled` every lookup fails. Production default until a key is supplied.
#
# GOOGLE_MAPS_SERVER_API_KEY must be a server key restricted to the Geocoding
# and Routes APIs. It is required when GEO_PROVIDER=google. The browser uses a
# separate referrer-restricted key (see frontend/.env.example).
# ---------------------------------------------------------------------------
GEO_PROVIDER=stub
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_TIMEOUT_MS=8000
DISTANCE_CACHE_DAYS=30

# ---------------------------------------------------------------------------
# Business thresholds (overridable per row in app_settings)
# ---------------------------------------------------------------------------
FLEET_APPROVAL_REQUIRED=false
STALE_DUE_DAYS=30
STALE_FLAG_DAYS=60
STALE_REMINDER_REPEAT_DAYS=7
RFQ_REMINDER_LEAD_HOURS=24
# Scratch database used only by `prisma migrate diff` to replay migration
# history. Created and dropped automatically; never holds real data.
SHADOW_DATABASE_URL=postgresql://sml.developer@localhost:5432/crossrental_shadow

# --- M2 onboarding ---
# How long a vendor invitation link stays usable, and how long a rejected
# vendor can correct and resubmit before the link lapses.
ONBOARDING_INVITATION_TTL_DAYS=7
ONBOARDING_RESUBMIT_WINDOW_DAYS=30
