// Crane Discovery & Vendor Repository Platform — vendor portal data model.
//
// Conventions copied from the CustomerPulse backend (same owner, same stack):
// camelCase columns with no @map, uuid() primary keys, SCREAMING_SNAKE enums,
// driver-adapter client generated into src/generated/prisma.
//
// Source of truth for the shape of this file is VendorPortalImplementation.md
// section 5. Reference data (State, CraneType) is seeded from the SAP
// standard-values sheet in docs/vendorregistrationform.xlsx.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  vendor_user
  admin_user
  sales_user
  // P5: read-only management viewer. Aggregated dashboards and reports only.
  management_viewer
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum NatureOfCompany {
  PUBLIC_LTD
  PRIVATE_LTD
  PARTNERSHIP
  PROPRIETORSHIP
}

enum GstFilingFrequency {
  MONTHLY
  QUARTERLY
  COMPOSITE
}

// Brief 5.1's GST registration type (only meaningful when gstRegistered).
// Replaces the old gst_composition_opted boolean, which could only say yes/no.
enum GstRegistrationType {
  REGULAR
  COMPOSITE
  SEZ
  EOU
}

enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
}

enum BankAccountType {
  SAVING
  CURRENT
  OTHER
}

// Office-use review block. Facilities get three states (the paper form's
// "Adequate / Not Adequate / need to be improved"), manpower only two.
enum FacilityStatus {
  ADEQUATE
  NOT_ADEQUATE
  NEEDS_IMPROVEMENT
}

enum ManpowerStatus {
  ADEQUATE
  NOT_ADEQUATE
}

enum DocumentType {
  CANCELLED_CHEQUE
  GST_CERTIFICATE
  PAN_COPY
  // Conditional documents (brief 7.2): the declaration scan is always
  // required; the other two only when the corresponding option applies.
  DECLARATION_SCAN
  TDS_CERTIFICATE
  MSME_CERTIFICATE
  OTHER
}

enum CraneStatus {
  AVAILABLE
  ENGAGED
  UNDER_MAINTENANCE
  // Brief 6.1 as revised (phase B): the vendor dropdown never offers the last
  // two, and nothing new should write them once reservations land. They stay in
  // the enum only for rows written before the reservation rework.
  BOOKED
  HIRED
}

// How a reservation commits the crane (brief 5.3/6.1). Booked comes from an
// award; Blocked is SML marking the crane unavailable by hand — a maintenance
// window is one of these, with the crane's own status left as the vendor set it.
enum ReservationType {
  BOOKED
  BLOCKED
}

// ---------------------------------------------------------------------------
// Enquiries (P1)
// ---------------------------------------------------------------------------

// The enquiry header's rolled-up status (P1 section 4).
enum EnquiryOverallStatus {
  RECEIVED_PENDING_SOURCING
  PARTIALLY_QUOTED
  PARTIALLY_FINALISED
  FULLY_FINALISED
  CLOSED
}

// The event-driven line-item status trail (BPD 6.5). Never typed in: every
// value is reached through a trigger (P1 section 3), and every change is audited.
enum EnquiryLineTrailStatus {
  NEW
  AVAILABILITY_CHECK
  VENDOR_SHORTLISTED
  RFQ_SENT
  AWAITING_QUOTES
  QUOTES_RECEIVED
  UNDER_EVALUATION
  VENDOR_FINALISED
  BOOKED
  CLOSED
  FULFILLED_INTERNALLY
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  COMPLETED
}

enum OwnershipType {
  VENDOR
  SML
}

enum CoordinateSource {
  auto
  manual
}

// Brief 6.4: FLEET_APPROVAL_REQUIRED=false means crane changes are live
// immediately, which is the default. The column exists so flipping the flag
// needs no schema change and no deploy; the review UI is deliberately deferred.
enum CraneApprovalStatus {
  APPROVED
  PENDING
}

enum RfqStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

// Extension point for the future line-item status trail (BPD 6.5 / 7.2).
enum RfqRollupStatus {
  SENT
  AWAITING_QUOTES
  QUOTES_RECEIVED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum ResponseStatus {
  PENDING
  QUOTED
  DECLINED
  EXPIRED
  // Written by the system, never by a vendor: the RFQ was finalised by another
  // vendor's award and this vendor never quoted. Without it the row keeps
  // reading "Awaiting your quote" and stays in their to-do list for ever.
  FINALISED
}

enum RateBasis {
  PER_DAY
  PER_MONTH
  LUMP_SUM
}

// Whether the quotation's total already includes GST (brief A2). Does not
// change any arithmetic: it tells sales how to compare two quotes.
enum TaxBasisOfQuotation {
  EXCLUSIVE_OF_GST
  INCLUSIVE_OF_GST
}

// How sales want candidates matched on capacity (brief A3): AT_LEAST admits a
// bigger crane, EXACT only one of the stated tonnage.
enum CapacityRule {
  AT_LEAST
  EXACT
}

enum DurationUnit {
  DAYS
  MONTHS
}

enum QuotationStatus {
  SUBMITTED
  WITHDRAWN
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  // Selected === "Awarded" as the vendor sees it.
  SELECTED
  NOT_AWARDED
}

enum QuoteSource {
  PORTAL
  EMAIL
  WHATSAPP
  MANUAL
}

// P6: how an RFQ was dispatched and how a message moved.
enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum InboundReplyStatus {
  PENDING
  CONVERTED
  DISMISSED
}

enum DistanceMethod {
  road
  straight_line
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
}

enum OtpPurpose {
  LOGIN
}

enum AttachmentKind {
  LOAD_CHART
  OTHER
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

model State {
  code             String  @id
  name             String  @unique
  isUnionTerritory Boolean @default(false)
  // P5 admin configuration: the sales region a state is mapped to. Optional
  // because the owner's mapping is not known yet; reports group on the
  // enquiry's own `region` and fall back to this when it is blank.
  region           String?

  vendorsOperating   StateVendorRegion[]
  rfqs               Rfq[]
  cranes             Crane[]
  vendorsWithAddress Vendor[]            @relation("VendorAddress")
  enquiries          Enquiry[]           @relation("EnquirySiteState")

  @@map("states")
}

// Operating regions are a multi-select over states. Kept as a join table
// rather than a Postgres array so a bad state code can never be stored.
model StateVendorRegion {
  vendorId  String
  stateCode String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  state  State  @relation(fields: [stateCode], references: [code])

  @@id([vendorId, stateCode])
  @@map("vendor_operating_regions")
}

model CraneType {
  code      String @id
  name      String @unique
  sortOrder Int    @default(0)

  cranes            Crane[]
  rfqCandidates     Rfq[]              @relation("RfqCandidateType")
  enquiryLines      EnquiryLineItem[]  @relation("EnquiryLineCraneType")
  mobilisationRates MobilisationRate[]

  @@map("crane_types")
}

// ---------------------------------------------------------------------------
// Vendor
// ---------------------------------------------------------------------------

model Vendor {
  id            String  @id @default(uuid())
  // Typed in by an admin, unique, may stay blank until SAP creates the
  // vendor. Number range from the SAP standard-values sheet (10000001).
  sapVendorCode String? @unique

  // ---------------------------------------------------------------------------
  // Onboarding inputs. These are nullable in the database because a vendor may
  // save a partial form as a Draft (brief 7.2) and come back to it later.
  // "Mandatory" in brief 5.1 is therefore enforced by validation at SUBMIT
  // time (services/onboarding.service.ts), not by NOT NULL. An APPROVED vendor
  // is guaranteed to have every field below populated.
  // ---------------------------------------------------------------------------

  name            String?
  natureOfCompany NatureOfCompany?

  // Structured address (brief 5.1 replaces the single registered-address text).
  // The state relation is named so it does not collide with the operating
  // regions join or the RFQ/crane state relations.
  addressLine1 String?
  addressLine2 String?
  city         String?
  district     String?
  stateCode    String?
  addressState State?  @relation("VendorAddress", fields: [stateCode], references: [code])
  pincode      String?

  telephone     String?
  fax           String?
  email         String?
  weeklyOffDays String?
  companySize   String?
  // PAN is unique across vendors when present (brief 5.1). The 4th letter is
  // the company-type letter — validated against natureOfCompany at submit.
  pan           String? @unique
  tan           String?

  // GST block. Whether the vendor is GST-registered drives everything else:
  // an unregistered vendor has no GSTN at all (stored as null), so the GSTN
  // unique index below only ever sees registered vendors' numbers.
  gstRegistered        Boolean?
  gstRegistrationType  GstRegistrationType?
  // Unique across vendors (brief 5.1). Nullable: Postgres permits many NULLs
  // under a unique index, which is what unregistered vendors need.
  gstn                 String?              @unique
  gstr1FilingFrequency GstFilingFrequency?
  cin                  String?
  govtRegistrationType String?
  govtRegistrationNo   String?

  // MSME block — category and registration number required when registered,
  // exemption certificate optional.
  msmeRegistered    Boolean?
  msmeCategory      MsmeCategory?
  msmeRegNo         String?
  msmeExemptionDate DateTime?

  // TDS lower-deduction block — certificate details required when claimed.
  tdsLowerDeduction Boolean?
  tdsCertificateNo  String?
  tdsSection        String?
  tdsRatePercent    Int?
  tdsValidFrom      DateTime?
  tdsValidTo        DateTime?

  // Bank block. Account number and IFSC are AES-256-GCM encrypted at rest
  // (see utils/crypto.ts); last4 is kept in clear so the UI can mask
  // without decrypting. Sales users never receive these fields at all.
  // MICR, IBAN and SWIFT are ordinary optional fields (the last two apply to
  // foreign banks only); nothing here needs masking.
  bankAccountHolderName String?
  bankName              String?
  bankBranch            String?
  bankAccountType       BankAccountType?
  bankAccountNoEnc      String?
  bankAccountNoLast4    String?
  bankIfscEnc           String?
  bankMicr              String?
  bankIban              String?
  bankSwift             String?

  codeOfConductAccepted  Boolean?
  declarationName        String?
  declarationDesignation String?
  declarationDate        DateTime?
  // The signed-and-stamped declaration page (open item 4, decided): the
  // checkbox stands and the scan is uploaded beside it as a
  // DECLARATION_SCAN document, required at submit.

  // Replaces the paper form's "Product range / HSN" block.
  fleetSummary String?

  // Communication preferences: email is the only channel for now (brief 3),
  // so this carries the vendor's notes on how they want to be reached.
  communicationNotes String?

  onboardingStatus OnboardingStatus @default(DRAFT)
  approvedById     String?
  approvedBy       User?            @relation("VendorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  adminRemarks     String?

  // P0 B2: an admin can suspend a vendor (it cannot sign in or receive RFQs)
  // and reinstate it. The reason is kept for the audit trail and the screen.
  suspendedAt   DateTime?
  suspendedById String?
  suspendedBy   User?     @relation("VendorSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendReason String?

  // Office-use review, admin only.
  facilityStatus         FacilityStatus?
  manpowerStatus         ManpowerStatus?
  improvementRequirement String?
  improvementPeriod      String?

  // Office-use master-list values for the SAP creation sheet (phase D3). The
  // admissible values live in admin-editable master lists (seeded empty, open
  // item 3) so the owner's SAP "Legal Form Logic" values load without a code
  // change; these columns hold the picked code for each field.
  vendorOrigin       String?
  vendorType         String?
  purchaseOrg        String?
  paymentTerm        String?
  withholdingTaxType String?
  legalForm          String?

  // Count of active cranes, maintained by the crane service.
  totalFleetSize Int @default(0)

  operatingRegions StateVendorRegion[]
  contacts         VendorContact[]
  documents        VendorDocument[]
  decisions        VendorDecision[]
  users            User[]
  invitations      VendorInvitation[]
  cranes           Crane[]
  rfqRecipients    RfqVendorRecipient[]
  quotations       Quotation[]
  inboundReplies   InboundReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([onboardingStatus])
  @@map("vendors")
}

model VendorContact {
  id       String @id @default(uuid())
  vendorId String

  name         String
  mobile       String
  telephone    String?
  // Unique so an approval can never try to create two portal logins for the
  // same address. Postgres permits many NULLs under a unique index, which
  // is what we want for contacts with no email.
  email        String? @unique
  isPrimary    Boolean @default(false)
  // Brief 5.3: RFQ emails go to contacts with this flag, falling back to the
  // primary contact when nobody on file has it set.
  receivesRfqs Boolean @default(false)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@map("vendor_contacts")
}

model VendorDocument {
  id       String       @id @default(uuid())
  vendorId String
  docType  DocumentType

  fileRef   String
  fileName  String
  mimeType  String?
  sizeBytes Int?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  uploadedBy String?

  @@index([vendorId])
  @@map("vendor_documents")
}

// ---------------------------------------------------------------------------
// Onboarding invitations and decisions (M2)
// ---------------------------------------------------------------------------

/// A single-use invitation that lets a new vendor fill in the onboarding form.
///
/// Brief 8 lists "Vendor invitation / registration" as an email an admin or
/// sales user sends, "replacing the current registration mail" where SML
/// emailed a paper form to be returned by email. So onboarding is invite-gated
/// rather than an open public sign-up: there is no endpoint anyone can POST a
/// new vendor to without holding a token, which also keeps junk out of the
/// admin approval queue.
///
/// Only the SHA-256 of the token is stored, so a leaked database does not hand
/// over working invitations. Same reasoning as the activation and reset tokens
/// on User.
model VendorInvitation {
  id String @id @default(uuid())

  tokenHash String @unique

  /// Prefills the form. Nullable so an admin can invite a company before it has
  /// settled on a contact address.
  email         String?
  companyName   String?
  contactName   String?
  /// The number SML will call about this vendor, captured at invitation time.
  contactNumber String?

  createdById String
  createdBy   User   @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  expiresAt DateTime

  /// Set once the vendor opens the link and starts a draft. From then on the
  /// draft vendor row owns the data and the invitation is only a pointer.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// When the onboarding form was submitted. The invitation cannot be reopened
  /// afterwards, so a vendor cannot edit an application already under review.
  submittedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([email])
  @@map("vendor_invitations")
}

/// An administrative decision on a submitted onboarding form. Kept as a row
/// rather than only as fields on Vendor so a resubmission after a rejection has
/// its own decision history.
model VendorDecision {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  outcome DecisionOutcome
  remarks String?

  decidedById String?
  decidedBy   User?   @relation("DecisionBy", fields: [decidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([vendorId])
  @@map("vendor_decisions")
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Users and auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Null until the activation link is used (vendors) or forever (internal
  // users, who authenticate by OTP).
  passwordHash String?
  fullName     String?
  role         UserRole

  // Null for admin_user and sales_user. Every vendor_user is scoped to
  // exactly one vendor and may only ever read/write that vendor's rows.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  // First-time activation (vendors).
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  activatedAt              DateTime?

  // Forgot-password.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  lastLoginAt DateTime?

  approvedVendors         Vendor[]                 @relation("VendorApprovedBy")
  suspendedVendors        Vendor[]                 @relation("VendorSuspendedBy")
  sentInvitations         VendorInvitation[]       @relation("InvitationCreatedBy")
  vendorDecisions         VendorDecision[]         @relation("DecisionBy")
  otps                    LoginOtp[]
  createdRfqs             Rfq[]                    @relation("RfqCreatedBy")
  auditLogs               AuditLog[]
  reservationsCreated     Reservation[]            @relation("ReservationCreatedBy")
  reservationsReleased    Reservation[]            @relation("ReservationReleasedBy")
  createdEnquiries        Enquiry[]                @relation("EnquiryCreatedBy")
  recommendationSnapshots RecommendationSnapshot[] @relation("RecommendationSnapshotBy")
  inboundRepliesReviewed  InboundReply[]           @relation("InboundReplyReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([role])
  @@map("users")
}

model LoginOtp {
  id      String     @id @default(uuid())
  userId  String
  purpose OtpPurpose @default(LOGIN)

  // Hashed, never the code itself.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Crane {
  id       String @id @default(uuid())
  vendorId String

  typeOfCraneCode String
  typeOfCrane     CraneType   @relation(fields: [typeOfCraneCode], references: [code])
  capacityT       Decimal     @db.Decimal(10, 2)
  currentStatus   CraneStatus
  currentLocation String
  stateCode       String
  state           State       @relation(fields: [stateCode], references: [code])
  make            String
  model           String
  yom             Int
  mainBoomM       Decimal?    @db.Decimal(6, 2)
  fixedJibM       Decimal?    @db.Decimal(6, 2)
  luffingJibM     Decimal?    @db.Decimal(6, 2)
  windJibM        Decimal?    @db.Decimal(6, 2)

  // Mandatory, unique per vendor among active cranes. The uniqueness is a
  // partial index added in a migration because Prisma cannot express it.
  serialRegistrationNo String
  pincode              String?

  latitude         Decimal?          @db.Decimal(10, 7)
  longitude        Decimal?          @db.Decimal(10, 7)
  coordinateSource CoordinateSource?
  geocodedBy       String?
  geocodedAt       DateTime?

  // Required when status is ENGAGED, cleared when it goes back to AVAILABLE.
  availableFrom DateTime?

  // Brief D4: optional, meaningful when status is UNDER_MAINTENANCE.
  expectedReadyDate DateTime?

  // Brief D1: true when the last change was made by an SML user for the vendor,
  // as opposed to the vendor themselves. Cleared whenever the vendor next edits
  // the crane.
  updatedOnBehalf Boolean @default(false)

  loadChartFileRef   String?
  loadChartFileName  String?
  loadChartMimeType  String?
  loadChartSizeBytes Int?

  ownershipType OwnershipType @default(VENDOR)
  isActive      Boolean       @default(true)
  remarks       String?

  // APPROVED unless FLEET_APPROVAL_REQUIRED is on, in which case new and edited
  // cranes arrive as PENDING until an admin releases them.
  approvalStatus CraneApprovalStatus @default(APPROVED)

  // Bumped on any status / location / available_from change. Drives the
  // 30-day "due for update" and 60-day "stale" thresholds.
  statusUpdatedAt DateTime @default(now())

  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quotations   Quotation[]
  auditLogs    AuditLog[]
  reservations Reservation[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  updatedBy      String?
  inboundReplies InboundReply[]

  @@index([vendorId, isActive])
  @@index([stateCode])
  @@index([currentStatus])
  @@index([typeOfCraneCode])
  @@map("cranes")
}

// ---------------------------------------------------------------------------
// RFQ and quotation
// ---------------------------------------------------------------------------

model Rfq {
  id        String @id @default(uuid())
  rfqNumber String @unique

  // Read-only snapshot of the SAP enquiry line item for now; a later phase
  // replaces these with the live SAP feed.
  enquiryNo String
  lineNo    String

  // A real foreign key, unlike the M1 original. M4's candidate picker filters
  // on `crane.typeOfCraneCode === rfq.craneType`, so a typo stored here would
  // return zero vendors and look like "no cranes match" rather than a typo.
  craneType    String
  craneTypeRef CraneType @relation("RfqCandidateType", fields: [craneType], references: [code])
  capacityT    Decimal   @db.Decimal(10, 2)
  quantity     Int       @default(1)

  // Brief A3: how candidates are matched on capacity, plus the free-text
  // elaboration the checkbox cannot carry. Matching still keys on tonnes;
  // the note is context, not a filter.
  capacityRule CapacityRule @default(AT_LEAST)
  capacityNote String?

  applicationDescription String?
  loadDescription        String?

  // Structured boom/jib requirements (brief A3). The quotation service warns
  // when the offered crane's boom is shorter than required.
  mainBoomM  Decimal? @db.Decimal(6, 2)
  jibLengthM Decimal? @db.Decimal(6, 2)

  // Brief A3: the customer has not fixed a start date, so the availability
  // confirmation is not demanded and the vendor is told why.
  startDateTbc        Boolean @default(false)
  /**
   * Used to convert months into days when RATE_DAY_BASIS is working days.
   */
  workingDaysPerMonth Int?

  siteLocation         String
  siteStateCode        String
  siteState            State             @relation(fields: [siteStateCode], references: [code])
  sitePincode          String?
  siteLatitude         Decimal?          @db.Decimal(10, 7)
  siteLongitude        Decimal?          @db.Decimal(10, 7)
  siteCoordinateSource CoordinateSource?

  requiredStartDate DateTime
  durationValue     Decimal      @db.Decimal(10, 2)
  durationUnit      DurationUnit

  configuration String?

  otCharges               String?
  breakdownTerms          String?
  dieselScope             String?
  workingHoursShift       String?
  craneAgeCriteriaYears   Int?
  accommodationConveyance String?
  paymentTerms            String?
  notes                   String?

  // P0 A4: the remaining terms named on the CR enquiry line item, kept as
  // their own columns (not buried in the JSON below) so they show on the
  // vendor's screen and in the invitation mail like every other term.
  mobilisationTerms   String?
  supportCrane        String?
  steelMatsGroundPrep String?
  ehsHrRequirements   String?
  insuranceTerms      String?
  extensionClause     String?

  // The remaining rows of the 31-row "Cross Rental Enquiry Template" in
  // docs/CR Enquiry from SP.xlsx, so nothing on the paper form is lost.
  commercialTermsExtra Json?

  smlContactName   String?
  smlContactMobile String?
  smlContactEmail  String?

  submissionDeadline DateTime
  status             RfqStatus        @default(DRAFT)
  rollupStatus       RfqRollupStatus?
  cancelledAt        DateTime?
  cancelReason       String?

  // P1: an RFQ raised from an enquiry line links back to it. `enquiryNo`/
  // `lineNo` above stay as the printed snapshot; this is the live link.
  enquiryLineId String?
  enquiryLine   EnquiryLineItem? @relation(fields: [enquiryLineId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User      @relation("RfqCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?

  // P6: how this RFQ was dispatched. A resend repeats the chosen channels.
  channels MessageChannel[] @default([EMAIL])

  recipients     RfqVendorRecipient[]
  quotations     Quotation[]
  attachments    RfqAttachment[]
  reservations   Reservation[]
  inboundReplies InboundReply[]

  @@index([status])
  @@index([submissionDeadline])
  @@map("rfqs")
}

model RfqAttachment {
  id    String @id @default(uuid())
  rfqId String

  fileRef   String
  fileName  String
  mimeType  String?
  sizeBytes Int?

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  uploadedBy String?

  @@map("rfq_attachments")
}

/**
 * The dated commitment record (brief 5.3 / 6.1 as revised).
 * A crane is committed through reservations, not through a stored status: the
 * "Booked" and "Hired" badges are derived from active reservations, and a
 * release is an operation on this row rather than a status flip. An award
 * writes the Booked row in the award transaction (phase B2); Blocked is SML
 * marking a crane unavailable by hand. The database refuses overlapping
 * ACTIVE reservations on one crane via the exclusion constraint in the
 * migration.
 */
model Reservation {
  id        String            @id @default(uuid())
  craneId   String
  startDate DateTime
  endDate   DateTime
  type      ReservationType
  status    ReservationStatus @default(ACTIVE)

  // Who this reservation is for. Null on a hand-made Blocked row.
  rfqId         String?
  quotationId   String?
  /// P1: the enquiry line this commitment serves, when it came from one.
  enquiryLineId String?

  // The admin who made it — award rows carry the awarding admin; Blocked rows
  // the admin who blocked. Release keeps the original creator and adds theirs.
  // Nullable only for the legacy rows the phase B migration synthesized.
  createdById   String?
  releasedById  String?
  releasedAt    DateTime?
  releaseReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crane       Crane            @relation(fields: [craneId], references: [id], onDelete: Cascade)
  rfq         Rfq?             @relation(fields: [rfqId], references: [id])
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  enquiryLine EnquiryLineItem? @relation(fields: [enquiryLineId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  releasedBy  User?            @relation("ReservationReleasedBy", fields: [releasedById], references: [id])

  @@index([craneId, status])
  @@index([status, startDate])
  @@map("reservations")
}

model RfqVendorRecipient {
  id       String @id @default(uuid())
  rfqId    String
  vendorId String

  // The addresses the dispatch actually used.
  emails String[]

  emailDeliveryStatus EmailDeliveryStatus @default(QUEUED)
  emailDeliveryError  String?

  // P6: WhatsApp uses the same delivery enum but its own status, so a failed
  // SMS does not erase a successful email (and vice versa).
  whatsappPhones         String[]             @default([])
  whatsappDeliveryStatus EmailDeliveryStatus?
  whatsappDeliveryError  String?
  whatsappMessageIds     String[]             @default([])

  firstViewedAt DateTime?

  responseStatus ResponseStatus @default(PENDING)
  respondedAt    DateTime?
  declineReason  String?
  declineNote    String?

  reminderCount  Int       @default(0)
  lastReminderAt DateTime?

  // The cranes and distances the sales user saw when the RFQ was sent.
  // Snapshots are never recomputed — crane locations move.
  candidateSnapshot Json?

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rfqId, vendorId])
  @@index([vendorId])
  @@index([responseStatus])
  @@map("rfq_vendor_recipients")
}

model Quotation {
  id       String @id @default(uuid())
  rfqId    String
  vendorId String
  craneId  String

  version  Int     @default(1)
  isLatest Boolean @default(true)

  rentalRate            Decimal             @db.Decimal(14, 2)
  rateBasis             RateBasis
  mobilisationCharges   Decimal             @default(0) @db.Decimal(14, 2)
  // Brief A2: demobilisation is its own line, not a note inside mobilisation.
  demobilisationCharges Decimal             @default(0) @db.Decimal(14, 2)
  // Whether the quoted total includes GST. Purely a declaration — it does not
  // change the arithmetic — but sales compare quotes on like terms, and the
  // paper form asked for it. Default brief 6.7: Exclusive of GST.
  taxBasis              TaxBasisOfQuotation @default(EXCLUSIVE_OF_GST)
  totalQuotedValue      Decimal             @db.Decimal(14, 2)
  // Human-readable working shown to the vendor before they submit, kept so
  // the receipt and history can reproduce it exactly.
  calculationNote       String?

  availabilityConfirmed Boolean
  availableFrom         DateTime?
  validityDate          DateTime

  acceptsCommercialTerms Boolean
  deviationText          String?
  remarks                String?

  // System-generated advisories (brief 6.7). Shown to the vendor before
  // they submit and to sales afterwards. Never block submission.
  warnings Json?

  submittedAt DateTime    @default(now())
  source      QuoteSource @default(PORTAL)

  // Crane state/location/coords at the moment of quoting, plus the distance
  // that was shown. Stored, never recalculated.
  craneLocationSnapshot Json?
  distanceToSiteKm      Decimal?        @db.Decimal(10, 2)
  distanceMethod        DistanceMethod?

  status QuotationStatus @default(SUBMITTED)

  // P3: the comparison mark (Under Review / Shortlisted / Rejected) and the
  // reason code behind it. Kept on the quotation so the comparison screen reads
  // the current mark directly; the full trail stays in AuditLog.
  statusReasonCode  String?
  statusReasonText  String?
  statusChangedAt   DateTime?
  statusChangedById String?

  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  crane  Crane  @relation(fields: [craneId], references: [id])

  attachments  QuotationAttachment[]
  reservations Reservation[]
  inboundReply InboundReply?         @relation("InboundReplyQuotation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Versions are scoped per crane: a vendor quoting two different cranes on
  // the same RFQ keeps two independent version series.
  @@unique([rfqId, vendorId, craneId, version])
  @@index([rfqId, isLatest])
  @@index([vendorId, status])
  @@map("quotations")
}

model QuotationAttachment {
  id          String         @id @default(uuid())
  quotationId String
  kind        AttachmentKind @default(OTHER)

  fileRef   String
  fileName  String
  mimeType  String?
  sizeBytes Int?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())

  @@map("quotation_attachments")
}

// ---------------------------------------------------------------------------
// Enquiries (P1)
// ---------------------------------------------------------------------------

/**
 * The enquiry header (BPD 6.3/6.4, P1 section 2).
 * The CR team types these in today; a future SAP feed would call the same
 * `createEnquiry(payload, source)` service, which is why `source` is a column
 * even though `manual` is the only value that exists. The customer's name and
 * address are internal-only and are never copied into an RFQ.
 */
model Enquiry {
  id                String        @id @default(uuid())
  enquiryNo   String        @unique
  enquiryDate DateTime

  // Internal only, never copied into an RFQ.
  customerName    String
  customerAddress String

  siteLocation  String
  siteStateCode String
  siteState     State   @relation("EnquirySiteState", fields: [siteStateCode], references: [code])
  sitePincode   String?
  region        String?

  // The job site's pin (P2). Geocoded once through the provider interface and
  // stored, so a recommendation run reuses it rather than looking up again. The
  // value is whatever the provider gave — with the stub that is a synthetic
  // point, hence `siteCoordinateSource`.
  siteLatitude         Decimal?          @db.Decimal(10, 7)
  siteLongitude        Decimal?          @db.Decimal(10, 7)
  siteCoordinateSource CoordinateSource?

  overallStatus EnquiryOverallStatus @default(RECEIVED_PENDING_SOURCING)

  createdById String?
  createdBy   User?   @relation("EnquiryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines EnquiryLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([overallStatus])
  @@index([enquiryDate])
  @@map("enquiries")
}

/**
 * One requirement line on an enquiry, derived from the Cross Rental Enquiry
 * Template (P1 section 2). All 31 template rows are represented, including the
 * five scope terms the first draft of the field list missed.
 * `rentalBudget`, `internalNotes` and `poSapReference` are internal only, as is
 * the customer block on the header: none of them is ever copied into an RFQ.
 */
model EnquiryLineItem {
  id        String  @id @default(uuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  /// Line number within the enquiry; unique per enquiry.
  lineNo Int

  // --- Requirement ---
  craneTypeCode String?
  craneType     CraneType?   @relation("EnquiryLineCraneType", fields: [craneTypeCode], references: [code])
  capacityT     Decimal?     @db.Decimal(10, 2)
  capacityRule  CapacityRule @default(AT_LEAST)
  capacityNote  String?
  quantity      Int          @default(1)

  // --- Application and load ---
  applicationDescription String?
  loadDescription        String?
  liftLoadT              Decimal? @db.Decimal(10, 2)
  workingRadiusM         Decimal? @db.Decimal(6, 2)

  // --- Configuration ---
  requiredMainBoomM   Decimal? @db.Decimal(6, 2)
  requiredFixedJibM   Decimal? @db.Decimal(6, 2)
  requiredLuffingJibM Decimal? @db.Decimal(6, 2)
  requiredWindJibM    Decimal? @db.Decimal(6, 2)
  configurationNotes  String?

  // --- Dates ---
  requiredStartDate   DateTime?
  durationValue       Decimal?      @db.Decimal(10, 2)
  durationUnit        DurationUnit?
  workingDaysPerMonth Int?

  // --- Mobilisation ---
  mobilisationTerms   String?
  demobilisationTerms String?

  // --- Terms and scopes (rows 12-25 of the template) ---
  otCharges                String?
  breakdownTerms           String?
  dieselScope              String?
  workingHoursShift        String?
  accommodationConveyance  String?
  paymentTerms             String?
  supportCraneScope        String?
  steelMatsGroundPrepScope String?
  ehsHrCompliance          String?
  insuranceTerms           String?
  extensionClause          String?
  craneAgeCriteriaYears    Int?
  otherTerms               String?

  // --- Template rows the first P1 draft missed (rows 26-30) ---
  additionalManpowerScope String?
  intraSiteMovementScope  String?
  prereleaseTerms         String?
  ppeScope                String?
  rowScope                String?

  // --- Internal only ---
  rentalBudget String?

  // --- Status (event driven; see services/enquiryTrail.service.ts) ---
  trailStatus    EnquiryLineTrailStatus @default(NEW)
  closureStatus  String?
  cancelledAt    DateTime?
  cancelReason   String?

  rfqs            Rfq[]
  reservations    Reservation[]
  recommendations RecommendationSnapshot[]
  inboundReplies  InboundReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enquiryId, lineNo])
  @@index([trailStatus])
  @@map("enquiry_line_items")
}

/// Per-calendar-year enquiry counter behind CR-2026-0001 (P1 section 1).
model EnquirySequence {
  year Int @id
  last Int @default(0)

  @@map("enquiry_sequences")
}

// ---------------------------------------------------------------------------
// Support tables
// ---------------------------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid())
  entity   String
  entityId String
  action   String

  // Status, location, approval and crane-field changes. Bank details are
  // never written here — see services/audit.service.ts.
  oldValue Json?
  newValue Json?

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole String?
  actorName String?
  ipAddress String?

  // Brief D1: true when an SML user made this change for the vendor. Mirrors
  // Crane.updatedOnBehalf so the audit trail reads correctly even after the
  // vendor's next change clears the crane flag.
  onBehalfOfVendor Boolean @default(false)

  craneId String?
  crane   Crane?  @relation(fields: [craneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/**
 * Every message the platform sent or received.
 * P6 widened this from outbound email only: `channel`, `direction`, the
 * inbound body and the provider's message id let WhatsApp and email replies
 * share the communication history the screen already reads. `toEmail` keeps its
 * old name for compatibility but now carries the destination address (email or
 * phone) for both channels.
 */
model EmailLog {
  id       String         @id @default(uuid())
  toEmail  String
  ccEmail  String?
  template String
  subject  String
  status   EmailLogStatus @default(QUEUED)
  error    String?

  channel           MessageChannel   @default(EMAIL)
  direction         MessageDirection @default(OUTBOUND)
  fromAddress       String?
  bodyText          String?
  bodyHtml          String?
  providerMessageId String?          @unique

  entity   String?
  entityId String?

  inboundReply InboundReply? @relation("InboundReplyMessage")

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([channel, direction])
  @@map("email_logs")
}

/**
 * P6 assisted validation queue.
 * A reply that cannot be turned into a complete quotation on its own lands
 * here. The parsed fields are deliberately columns rather than JSON: an admin
 * edits them in the queue, and the converted quotation records where it came
 * from through `QuoteSource`.
 */
model InboundReply {
  id           String   @id @default(uuid())
  messageLogId String   @unique
  messageLog   EmailLog @relation("InboundReplyMessage", fields: [messageLogId], references: [id], onDelete: Cascade)

  channel     MessageChannel
  fromAddress String
  subject     String?
  bodyText    String
  receivedAt  DateTime

  vendorId      String?
  vendor        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  rfqId         String?
  rfq           Rfq?             @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  enquiryLineId String?
  enquiryLine   EnquiryLineItem? @relation(fields: [enquiryLineId], references: [id], onDelete: SetNull)

  matchedBy String?
  parseNote String?

  parsedRentalRate     Decimal?   @db.Decimal(14, 2)
  parsedRateBasis      RateBasis?
  parsedMobilisation   Decimal?   @db.Decimal(14, 2)
  parsedDemobilisation Decimal?   @db.Decimal(14, 2)
  parsedAvailability   Boolean?
  parsedAvailableFrom  DateTime?
  parsedValidityDate   DateTime?
  parsedCraneRef       String?
  parsedRemarks        String?
  parsedAcceptsTerms   Boolean?

  craneId String?
  crane   Crane?  @relation(fields: [craneId], references: [id], onDelete: SetNull)

  attachments Json?

  status InboundReplyStatus @default(PENDING)

  convertedQuotationId String?    @unique
  convertedQuotation   Quotation? @relation("InboundReplyQuotation", fields: [convertedQuotationId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedBy   User?     @relation("InboundReplyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([rfqId])
  @@index([vendorId])
  @@map("inbound_replies")
}

model DistanceCache {
  id String @id @default(uuid())

  originLat Decimal @db.Decimal(10, 7)
  originLng Decimal @db.Decimal(10, 7)
  destLat   Decimal @db.Decimal(10, 7)
  destLng   Decimal @db.Decimal(10, 7)

  roadDistanceKm Decimal @db.Decimal(10, 2)
  provider       String

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([originLat, originLng, destLat, destLng])
  @@map("distance_cache")
}

// Key/value store for the thresholds and switches the brief calls
// configurable: fleet_approval_required, stale-data windows, reminder lead
// times, distance cache lifetime.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("app_settings")
}

// Per-calendar-year RFQ counter behind RFQ-2026-0001.
model RfqSequence {
  year Int @id
  last Int @default(0)

  @@map("rfq_sequences")
}

// Email bodies live in the database so they can be edited without a deploy.
// Seeded from services/emailTemplates.ts; {{placeholders}} are substituted
// at send time.
model EmailTemplate {
  key       String   @id
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ---------------------------------------------------------------------------
// Recommendation and mobilisation cost (P2)
// ---------------------------------------------------------------------------

/**
 * A frozen recommendation result for one enquiry line (BPD 7.1, P2 section 1).
 * The brief is explicit that a recommendation is a snapshot, not a live view:
 * crane locations move, so a result sales acted on yesterday must still read the
 * same way tomorrow. Every evaluation writes a new row and none is ever edited;
 * a refresh adds a row rather than replacing one.
 * The SML and vendor sets live in separate columns on purpose. The hard rule is
 * that the two are never merged, and two columns make a merge a deliberate
 * schema change rather than an accident in a mapper.
 */
model RecommendationSnapshot {
  id            String          @id @default(uuid())
  enquiryLineId String
  enquiryLine   EnquiryLineItem @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)

  /// "initial" on the first evaluation, "refresh" when a user re-ran it.
  trigger String @default("initial")

  /// The provider that produced the distances in this run ("stub", "haversine",
  /// "none", or a future vendor). Kept so a synthetic figure is traceable.
  provider String?

  /// The job site as it was pinned when this ran; later edits do not rewrite it.
  site      Json
  /// The SML set (empty: there is no SML crane fleet) and the manual internal
  /// check outcome. Kept apart from the vendor set.
  smlSet    Json
  /// The vendor set: grouped cranes, distances, costs, warnings and metrics.
  vendorSet Json

  createdById String?
  createdBy   User?   @relation("RecommendationSnapshotBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([enquiryLineId, createdAt])
  @@map("recommendation_snapshots")
}

/**
 * Per-km mobilisation rate by crane category and capacity band (BPD 5.5, P2
 * section 2). The owner supplies the values; until Admin Configuration (P5)
 * they are seeded from src/lib/mobilisationRates.ts.
 * `capacityMaxT` null means "no upper bound". `ownershipType` null means the
 * rate applies regardless of who owns the crane; a row that names an ownership
 * type wins over a null row for that crane.
 */
model MobilisationRate {
  id String @id @default(uuid())

  craneTypeCode String
  craneType     CraneType @relation(fields: [craneTypeCode], references: [code])

  capacityMinT  Decimal        @db.Decimal(10, 2)
  capacityMaxT  Decimal?       @db.Decimal(10, 2)
  ownershipType OwnershipType?

  ratePerKm Decimal @db.Decimal(12, 2)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([craneTypeCode])
  @@map("mobilisation_rates")
}
