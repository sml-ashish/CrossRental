# Local environment for the frontend.
#
# The Vite dev server proxies /api to the backend (see vite.config.ts), so the
# browser never needs a backend origin and CORS stays out of development.

# Backend origin the dev proxy forwards /api to.
VITE_API_PROXY=http://localhost:4000

# Base path for API calls made at runtime. Leave as-is in development, where the
# proxy handles it; a production deployment may set this to an absolute origin.
VITE_API_BASE_URL=/api