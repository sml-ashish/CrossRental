# Local environment for the frontend.
#
# The Vite dev server proxies /api to the backend (see vite.config.ts), so the
# browser never needs a backend origin and CORS stays out of development.

# Backend origin the dev proxy forwards /api to.
VITE_API_PROXY=http://localhost:4000

# Base path for API calls made at runtime. Leave as-is in development, where the
# proxy handles it; a production deployment may set this to an absolute origin.
VITE_API_BASE_URL=/api

# Google Maps JavaScript API key for the discovery map and heat map.
#
# Use a BROWSER key, restricted by HTTP referrer (localhost:5173 in development,
# the deployed origin in UAT/production) and limited to the Maps JavaScript API.
# Never put the server geocoding/routing key here: Vite inlines this value into
# the bundle. When it is empty the map falls back to the Leaflet map with a
# notice, and routes are unavailable.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Map ID for the Maps JavaScript API.
#
# The dark colour scheme and cloud-styled maps need a Map ID. `DEMO_MAP_ID` is
# supplied by Google for development; production must set an ID from the
# Google Cloud console (Map Management → Map IDs).
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Basemap tiles, shared by the discovery and job-site maps.
#
# The default is Esri World Street Map: keyless, with English place names. The
# browser darkens it by inverting the tile pane. To use a native dark provider
# (MapTiler, Stadia, CARTO), set the URL and attribution below and set
# VITE_MAP_TILES_INVERTED=false.
# VITE_MAP_TILES_URL=
# VITE_MAP_TILES_ATTRIBUTION=
# VITE_MAP_TILES_INVERTED=false
# VITE_MAP_TILES_MAX_ZOOM=19