# ============================================================================
# CROSSRENTAL - ROOT .env FOR DOCKER COMPOSE
# Place this file beside docker-compose.yml
# ============================================================================

# Database
DATABASE_URL=postgresql://itsm:itsm_movers_db_2026@host.docker.internal:5432/crossrental

# Application
NODE_ENV=production
PORT=3004
APP_URL=http://65.1.127.173:5174
CORS_ORIGINS=http://65.1.127.173:5174

# Authentication
# Replace with a newly generated secret before deployment:
# openssl rand -base64 48
JWT_SECRET=j3sRSJ7Uv58m8XPd2IU1WG2nx895TnY4D5Lv8hqWNUjHAyfwWq4/JKjxNA5quzaN
JWT_EXPIRES_IN=12h

VENDOR_PASSWORD_MIN_LENGTH=10
ACTIVATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_RESET_PER_15MIN=5
RATE_LIMIT_OTP_REQUEST_PER_15MIN=5
RATE_LIMIT_OTP_VERIFY_PER_15MIN=10
RATE_LIMIT_API_PER_MIN=600

# SMTP variables are required by the current docker-compose.yml even when
# MAIL_TRANSPORT=console. Console mode logs mail/OTP to backend logs.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cranes@sanghvimovers.com
SMTP_PASS=not-used-in-console-mode
MAIL_FROM="SML Crane Portal <cranes@sanghvimovers.com>"
INTERNAL_NOTIFY_EMAIL=cranes@sanghvimovers.com
MAIL_TRANSPORT=console

# Field encryption
# Keep the existing key if encrypted data already exists.
# The value below is a placeholder: insert your existing 32-byte base64 key.
FIELD_ENCRYPTION_KEY=v8O6GmyTP35LHwEiCU6VR2qqOxcTfMXCG2rj086OvyU=

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads
UPLOAD_MAX_MB=10

# Google Maps - server key and browser key must be separate.
GEO_PROVIDER=google
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyBDYa0VxETz8xO8ZdgIghOJ3v8Od8tQHt0
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_TIMEOUT_MS=8000
DISTANCE_CACHE_DAYS=30

# Frontend browser key; Compose passes this as a build argument.
VITE_GOOGLE_MAPS_BROWSER_KEY=AIzaSyBDYa0VxETz8xO8ZdgIghOJ3v8Od8tQHt0

# Microsoft SSO
SSO_PROVIDER=disabled
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
SSO_ALLOWED_DOMAINS=sanghvimovers.com

# WhatsApp
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# IMAP email reply capture
IMAP_POLL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# Business configuration
FLEET_APPROVAL_REQUIRED=false
STALE_DUE_DAYS=30
STALE_FLAG_DAYS=60
STALE_REMINDER_REPEAT_DAYS=7
RFQ_REMINDER_LEAD_HOURS=24
ONBOARDING_INVITATION_TTL_DAYS=7
ONBOARDING_RESUBMIT_WINDOW_DAYS=30

# Database seeding / UAT
RUN_SEED=true
SEED_DEMO_DATA=true
EXPOSE_OTP=true
