# UAT environment: copy to `.env` next to docker-compose.yml on the server and
# fill it in once. It is hand-managed on the server and never committed; the
# deploy script only updates the git checkout, so `.env` is left untouched.
#
# Generate the two secrets with:
#   openssl rand -hex 32            # FIELD_ENCRYPTION_KEY (must decode to 32 bytes)
#   openssl rand -base64 48         # JWT_SECRET

# --- database --------------------------------------------------------------
# UAT uses the existing `itsm-db` Postgres container (postgres:16-alpine), which
# publishes 5432 on the host. Create the database once inside it:
#   docker exec -it itsm-db psql -U itsm -d postgres -c "CREATE DATABASE crossrental OWNER itsm;"
# `host.docker.internal` is mapped to the host by docker-compose.yml.
DATABASE_URL=postgresql://itsm:itsm_movers_db_2026@host.docker.internal:5432/crossrental

# --- public origin ---------------------------------------------------------
# The address users open for UAT. Emails link back here and the API allows it.
APP_URL=http://YOUR_UAT_SERVER_IP:5174
CORS_ORIGINS=http://YOUR_UAT_SERVER_IP:5174

# --- auth / encryption -----------------------------------------------------
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=12h
FIELD_ENCRYPTION_KEY=64-hex-characters-32-bytes

# --- mail ------------------------------------------------------------------
# Use real SMTP in production, or set MAIL_TRANSPORT=console with
# SMTP_HOST=console SMTP_USER=console SMTP_PASS=console to log mail only.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cranes@sanghvimovers.com
SMTP_PASS=change-me
MAIL_FROM="SML Crane Portal <cranes@sanghvimovers.com>"
INTERNAL_NOTIFY_EMAIL=cranes@sanghvimovers.com
MAIL_TRANSPORT=smtp

# --- runtime ---------------------------------------------------------------
UPLOAD_MAX_MB=10
GEO_PROVIDER=disabled
# UAT convenience: shows the staff sign-in code under the email field.
# Never enable this in production.
EXPOSE_OTP=true
# Seed reference data + internal accounts on boot.
# UAT keeps demo vendors/cranes so testers can exercise vendor flows. Set this
# to false on a production deployment so known demo logins never reach a server.
RUN_SEED=true
SEED_DEMO_DATA=true
FLEET_APPROVAL_REQUIRED=false
