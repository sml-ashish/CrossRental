l. So onboarding is invite-gated\n/// rather than an open public sign-up: there is no endpoint anyone can POST a\n/// new vendor to without holding a token, which also keeps junk out of the\n/// admin approval queue.\n///\n/// Only the SHA-256 of the token is stored, so a leaked database does not hand\n/// over working invitations. Same reasoning as the activation and reset tokens\n/// on User.\nmodel VendorInvitation {\n  id String @id @default(uuid())\n\n  tokenHash String @unique\n\n  /// Prefills the form. Nullable so an admin can invite a company before it has\n  /// settled on a contact address.\n  email       String?\n  companyName String?\n  contactName String?\n\n  createdById String\n  createdBy   User   @relation(\"InvitationCreatedBy\", fields: [createdById], references: [id], onDelete: Cascade)\n\n  expiresAt DateTime\n\n  /// Set once the vendor opens the link and starts a draft. From then on the\n  /// draft vendor row owns the data and the invitation is only a pointer.\n  vendorId String?\n  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)\n\n  /// When the onboarding form was submitted. The invitation cannot be reopened\n  /// afterwards, so a vendor cannot edit an application already under review.\n  submittedAt DateTime?\n\n  revokedAt DateTime?\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([vendorId])\n  @@index([email])\n  @@map(\"vendor_invitations\")\n}\n\n/// An administrative decision on a submitted onboarding form. Kept as a row\n/// rather than only as fields on Vendor so a resubmission after a rejection has\n/// its own decision history.\nmodel VendorDecision {\n  id       String @id @default(uuid())\n  vendorId String\n  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)\n\n  outcome DecisionOutcome\n  remarks String?\n\n  decidedById String?\n  decidedBy   User?   @relation(\"DecisionBy\", fields: [decidedById], references: [id], onDelete: SetNull)\n\n  createdAt DateTime @default(now())\n\n  @@index([vendorId])\n  @@map(\"vendor_decisions\")\n}\n\nenum DecisionOutcome {\n  APPROVED\n  REJECTED\n}\n\n// ---------------------------------------------------------------------------\n// Users and auth\n// ---------------------------------------------------------------------------\n\nmodel User {\n  id           String   @id @default(uuid())\n  email        String   @unique\n  // Null until the activation link is used (vendors) or forever (internal\n  // users, who authenticate by OTP).\n  passwordHash String?\n  fullName     String?\n  role         UserRole\n\n  // Null for admin_user and sales_user. Every vendor_user is scoped to\n  // exactly one vendor and may only ever read/write that vendor's rows.\n  vendorId String?\n  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)\n\n  isActive Boolean @default(true)\n\n  // First-time activation (vendors).\n  activationToken          String?   @unique\n  activationTokenExpiresAt DateTime?\n  activatedAt              DateTime?\n\n  // Forgot-password.\n  resetToken          String?   @unique\n  resetTokenExpiresAt DateTime?\n\n  lastLoginAt DateTime?\n\n  approvedVendors Vendor[]           @relation(\"VendorApprovedBy\")\n  sentInvitations VendorInvitation[] @relation(\"InvitationCreatedBy\")\n  vendorDecisions VendorDecision[]   @relation(\"DecisionBy\")\n  otps            LoginOtp[]\n  createdRfqs     Rfq[]              @relation(\"RfqCreatedBy\")\n  auditLogs       AuditLog[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  @@index([vendorId])\n  @@index([role])\n  @@map(\"users\")\n}\n\nmodel LoginOtp {\n  id      String     @id @default(uuid())\n  userId  String\n  purpose OtpPurpose @default(LOGIN)\n\n  // Hashed, never the code itself.\n  codeHash   String\n  expiresAt  DateTime\n  consumedAt DateTime?\n  attempts   Int       @default(0)\n\n  ipAddress String?\n\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  createdAt DateTime @default(now())\n\n  @@index([userId])\n  @@map(\"login_otps\")\n}\n\n// ---------------------------------------------------------------------------\n// Fleet\n// ---------------------------------------------------------------------------\n\nmodel Crane {\n  id       String @id @default(uuid())\n  vendorId String\n\n  typeOfCraneCode String\n  typeOfCrane     CraneType   @relation(fields: [typeOfCraneCode], references: [code])\n  capacityT       Decimal     @db.Decimal(10, 2)\n  currentStatus   CraneStatus\n  currentLocation String\n  stateCode       String\n  state           State       @relation(fields: [stateCode], references: [code])\n  make            String\n  model           String\n  yom             Int\n  mainBoomM       Decimal?    @db.Decimal(6, 2)\n  fixedJibM       Decimal?    @db.Decimal(6, 2)\n  luffingJibM     Decimal?    @db.Decimal(6, 2)\n  windJibM        Decimal?    @db.Decimal(6, 2)\n\n  // Mandatory, unique per vendor among active cranes. The uniqueness is a\n  // partial index added in a migration because Prisma cannot express it.\n  serialRegistrationNo String\n  pincode              String?\n\n  latitude         Decimal?          @db.Decimal(10, 7)\n  longitude        Decimal?          @db.Decimal(10, 7)\n  coordinateSource CoordinateSource?\n  geocodedBy       String?\n  geocodedAt       DateTime?\n\n  // Required when status is ENGAGED, cleared when it goes back to AVAILABLE.\n  availableFrom DateTime?\n\n  loadChartFileRef   String?\n  loadChartFileName  String?\n  loadChartMimeType  String?\n  loadChartSizeBytes Int?\n\n  ownershipType OwnershipType @default(VENDOR)\n  isActive      Boolean       @default(true)\n  remarks       String?\n\n  // APPROVED unless FLEET_APPROVAL_REQUIRED is on, in which case new and edited\n  // cranes arrive as PENDING until an admin releases them.\n  approvalStatus CraneApprovalStatus @default(APPROVED)\n\n  // Bumped on any status / location / available_from change. Drives the\n  // 30-day \"due for update\" and 60-day \"stale\" thresholds.\n  statusUpdatedAt DateTime @default(now())\n\n  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)\n  quotations Quotation[]\n  auditLogs  AuditLog[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  updatedBy String?\n\n  @@index([vendorId, isActive])\n  @@index([stateCode])\n  @@index([currentStatus])\n  @@index([typeOfCraneCode])\n  @@map(\"cranes\")\n}\n\n// ---------------------------------------------------------------------------\n// RFQ and quotation\n// ---------------------------------------------------------------------------\n\nmodel Rfq {\n  id        String @id @default(uuid())\n  rfqNumber String @unique\n\n  // Read-only snapshot of the SAP enquiry line item for now; a later phase\n  // replaces these with the live SAP feed.\n  enquiryNo String\n  lineNo    String\n\n  // A real foreign key, unlike the M1 original. M4's candidate picker filters\n  // on `crane.typeOfCraneCode === rfq.craneType`, so a typo stored here would\n  // return zero vendors and look like \"no cranes match\" rather than a typo.\n  craneType    String\n  craneTypeRef CraneType @relation(\"RfqCandidateType\", fields: [craneType], references: [code])\n  capacityT    Decimal   @db.Decimal(10, 2)\n  quantity     Int       @default(1)\n\n  siteLocation         String\n  siteStateCode        String\n  siteState            State             @relation(fields: [siteStateCode], references: [code])\n  sitePincode          String?\n  siteLatitude         Decimal?          @db.Decimal(10, 7)\n  siteLongitude        Decimal?          @db.Decimal(10, 7)\n  siteCoordinateSource CoordinateSource?\n\n  requiredStartDate DateTime\n  durationValue     Decimal      @db.Decimal(10, 2)\n  durationUnit      DurationUnit\n\n  configuration String?\n\n  otCharges               String?\n  breakdownTerms          String?\n  dieselScope             String?\n  workingHoursShift       String?\n  craneAgeCriteriaYears   Int?\n  accommodationConveyance String?\n  paymentTerms            String?\n  notes                   String?\n\n  // The remaining rows of the 31-row \"Cross Rental Enquiry Template\" in\n  // docs/CR Enquiry from SP.xlsx, so nothing on the paper form is lost.\n  commercialTermsExtra Json?\n\n  smlContactName   String?\n  smlContactMobile String?\n  smlContactEmail  String?\n\n  submissionDeadline DateTime\n  status             RfqStatus        @default(DRAFT)\n  rollupStatus       RfqRollupStatus?\n  cancelledAt        DateTime?\n  cancelReason       String?\n\n  createdById String\n  createdBy   User      @relation(\"RfqCreatedBy\", fields: [createdById], references: [id])\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n  sentAt      DateTime?\n\n  recipients  RfqVendorRecipient[]\n  quotations  Quotation[]\n  attachments RfqAttachment[]\n\n  @@index([status])\n  @@index([submissionDeadline])\n  @@map(\"rfqs\")\n}\n\nmodel RfqAttachment {\n  id    String @id @default(uuid())\n  rfqId String\n\n  fileRef   String\n  fileName  String\n  mimeType  String?\n  sizeBytes Int?\n\n  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)\n\n  uploadedAt DateTime @default(now())\n  uploadedBy String?\n\n  @@map(\"rfq_attachments\")\n}\n\nmodel RfqVendorRecipient {\n  id       String @id @default(uuid())\n  rfqId    String\n  vendorId String\n\n  // The addresses the dispatch actually used.\n  emails String[]\n\n  emailDeliveryStatus EmailDeliveryStatus @default(QUEUED)\n  emailDeliveryError  String?\n\n  firstViewedAt DateTime?\n\n  responseStatus ResponseStatus @default(PENDING)\n  respondedAt    DateTime?\n  declineReason  String?\n  declineNote    String?\n\n  reminderCount  Int       @default(0)\n  lastReminderAt DateTime?\n\n  // The cranes and distances the sales user saw when the RFQ was sent.\n  // Snapshots are never recomputed