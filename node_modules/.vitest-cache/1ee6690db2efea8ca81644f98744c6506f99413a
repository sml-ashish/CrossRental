e\n  // that was shown. Stored, never recalculated.\n  craneLocationSnapshot Json?\n  distanceToSiteKm      Decimal?        @db.Decimal(10, 2)\n  distanceMethod        DistanceMethod?\n\n  status QuotationStatus @default(SUBMITTED)\n\n  rfq    Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)\n  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)\n  crane  Crane  @relation(fields: [craneId], references: [id])\n\n  attachments QuotationAttachment[]\n\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  // Versions are scoped per crane: a vendor quoting two different cranes on\n  // the same RFQ keeps two independent version series.\n  @@unique([rfqId, vendorId, craneId, version])\n  @@index([rfqId, isLatest])\n  @@index([vendorId, status])\n  @@map(\"quotations\")\n}\n\nmodel QuotationAttachment {\n  id          String         @id @default(uuid())\n  quotationId String\n  kind        AttachmentKind @default(OTHER)\n\n  fileRef   String\n  fileName  String\n  mimeType  String?\n  sizeBytes Int?\n\n  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)\n\n  uploadedAt DateTime @default(now())\n\n  @@map(\"quotation_attachments\")\n}\n\n// ---------------------------------------------------------------------------\n// Support tables\n// ---------------------------------------------------------------------------\n\nmodel AuditLog {\n  id       String @id @default(uuid())\n  entity   String\n  entityId String\n  action   String\n\n  // Status, location, approval and crane-field changes. Bank details are\n  // never written here — see services/audit.service.ts.\n  oldValue Json?\n  newValue Json?\n\n  actorId   String?\n  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)\n  actorRole String?\n  actorName String?\n  ipAddress String?\n\n  craneId String?\n  crane   Crane?  @relation(fields: [craneId], references: [id], onDelete: Set