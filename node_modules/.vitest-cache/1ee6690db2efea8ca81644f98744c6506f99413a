tate {\n  code             String  @id\n  name             String  @unique\n  isUnionTerritory Boolean @default(false)\n\n  vendorsOperating   StateVendorRegion[]\n  rfqs               Rfq[]\n  cranes             Crane[]\n  vendorsWithAddress Vendor[]            @relation(\"VendorAddress\")\n\n  @@map(\"states\")\n}\n\n// Operating regions are a multi-select over states. Kept as a join table\n// rather than a Postgres array so a bad state code can never be stored.\nmodel StateVendorRegion {\n  vendorId  String\n  stateCode String\n\n  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)\n  state  State  @relation(fields: [stateCode], references: [code])\n\n  @@id([vendorId, stateCode])\n  @@map(\"vendor_operating_regions\")\n}\n\nmodel CraneType {\n  code      String @id\n  name      String @unique\n  sortOrder Int    @default(0)\n\n  cranes        Crane[]\n  rfqCandidates Rfq[]   @relation(\"RfqCandidateType\")\n\n  @@map(\"crane_types\")\n}\n\n// ---------------------------------------------------------------------------\n// Vendor\n// ---------------------------------------------------------------------------\n\nmodel Vendor {\n  id            String  @id @default(uuid())\n  // Typed in by an admin, unique, may stay blank until SAP creates the\n  // vendor. Number range from the SAP standard-values sheet (10000001).\n  sapVendorCode String? @unique\n\n  // ---------------------------------------------------------------------------\n  // Onboarding inputs. These are nullable in the database because a vendor may\n  // save a partial form as a Draft (brief 7.2) and come back to it later.\n  // \"Mandatory\" in brief 5.1 is therefore enforced by validation at SUBMIT\n  // time (services/onboarding.service.ts), not by NOT NULL. An APPROVED vendor\n  // is guaranteed to have every field below populated.\n  // ---------------------------------------------------------------------------\n\n  name            String?\n  natureOfCompany NatureOfCompany?\n\n  // Structured address (brief 5.1 replaces the single registered-address text).\n  // The state relation is named so it does not collide with the operating\n  // regions join or the RFQ/crane state relations.\n  addressLine1 String?\n  addressLine2 String?\n  city         String?\n  district     String?\n  stateCode    String?\n  addressState State?  @relation(\"VendorAddress\", fields: [stateCode], references: [code])\n  pincode      String?\n\n  telephone     String?\n  fax           String?\n  email         String?\n  weeklyOffDays String?\n  companySize   String?\n  // PAN is unique across vendors when present (brief 5.1). The 4th letter is\n  // the company-type letter — validated against natureOfCompany at submit.\n  pan           String? @unique\n  tan           String?\n\n  // GST block. Whether the vendor is GST-registered drives everything else:\n  // an unregistered vendor has no GSTN at all (stored as null), so the GSTN\n  // unique index below only ever sees registered vendors' numbers.\n  gstRegistered        Boolean?\n  gstRegistrationType  GstRegistrationType?\n  // Unique across vendors (brief 5.1). Nullable: Postgres permits many NULLs\n  // under a unique index, which is what unregistered vendors need.\n  gstn                 String?              @unique\n  gstr1FilingFrequency GstFilingFrequency?\n  cin                  String?\n  govtRegistrationType String?\n  govtRegistrationNo   String?\n\n  // MSME block — category and registration number required when registered,\n  // exemption certificate optional.\n  msmeRegistered    Boolean?\n  msmeCategory      MsmeCategory?\n  msmeRegNo         String?\n  msmeExemptionDate DateTime?\n\n  // TDS lower-deduction block — certificate details required when claimed.\n  tdsLowerDeduction Boolean?\n  tdsCertificateNo  String?\n  tdsSection        String?\n  tdsRatePercent    Int?\n  tdsValidFrom      DateTime?\n  tdsValidTo        DateTime?\n\n  // Bank block. Account number and IFSC are AES-256-GCM encrypted at rest\n  // (see utils/crypto.ts); last4 is kept in clear so the UI can mask\n  // without decrypting. Sales users never receive these fields at all.\n  // MICR, IBAN and SWIFT are ordinary optional fields (the last two apply to\n  // foreign banks only); nothing here needs masking.\n  bankAccountHolderName String?\n  bankName              String?\n  bankBranch            String?\n  bankAccountType       BankAccountType?\n  bankAccountNoEnc      String?\n  bankAccountNoLast4    String?\n  bankIfscEnc           String?\n  bankMicr              String?\n  bankIban              String?\n  bankSwift             String?\n\n  codeOfConductAccepted  Boolean?\n  declarationName        String?\n  declarationDesignation String?\n  declarationDate        DateTime?\n  // The signed-and-stamped declaration page (open item 4, decided): the\n  // checkbox stands and the scan is uploaded beside it as a\n  // DECLARATION_SCAN document, required at submit.\n\n  // Replaces the paper form's \"Product range / HSN\" block.\n  fleetSummary String?\n\n  // Communication preferences: email is the only channel for now (brief 3),\n  // so this carries the vendor's notes on how they want to be reached.\n  communicationNotes String?\n\n  onboardingStatus OnboardingStatus @default(DRAFT)\n  approvedById     String?\n  approvedBy       User?            @relation(\"VendorApprovedBy\", fields: [approvedById], references: [id], onDelete: SetNull)\n  approvedAt       DateTime?\n  adminRemarks     String?\n\n  // Office-use review, admin only.\n  facilityStatus         FacilityStatus?\n  manpowerStatus         ManpowerStatus?\n  improvementRequirement String?\n  improvementPeriod      String?\n\n  // Count of active cranes, maintained by the crane service.\n  totalFleetSize Int @default(0)\n\n  operatingRegions StateVendorRegion[]\n  contacts         VendorContact[]\n  documents        VendorDocument[]\n  decisions        VendorDecision[]\n  users            User[]\n  invitations      